# =============================================================================
# Шесть городов — пример конфигурации окружения.
# Скопируйте в .env и заполните под свою среду.
# .env не должен попадать в систему контроля версий.
# =============================================================================

# HTTP-сервер
PORT=3000
LOG_LEVEL=info
LOG_FILE_PATH=./logs/cli-app.log

# Источник тестовых данных для CLI (--generate)
MOCK_DATA_URL=https://example.com/images
DEFAULT_DATA_PATH=./data

# MongoDB
MONGO_URI=mongodb://admin:admin@localhost:27017/six-cities?authSource=admin
MONGO_DB_NAME=six-cities

# JWT
JWT_SECRET=change_me
JWT_EXPIRES_IN=1d

# Директория для загруженных файлов (аватары)
UPLOAD_DIRECTORY=./upload

# =============================================================================
# Переменные docker-compose (используются только для контейнера MongoDB)
# =============================================================================
DB_USER=admin
DB_PASSWORD=admin
DB_PORT=27017

# Учётные данные для Mongo Express (веб-интерфейс)
UI_USER=admin
UI_PASSWORD=admin
